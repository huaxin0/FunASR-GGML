+        ctx, q, k_cache, v_cache, block_table, NULL,
+        scale, block_size, n_kv, n_head_kv);
+}
+
+struct ggml_tensor * ggml_paged_attn_ext_v(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * q,
+        struct ggml_tensor  * k_cache,
+        struct ggml_tensor  * v_cache,
+        struct ggml_tensor  * block_table,
+        struct ggml_tensor  * kv_lens,
+        float                 scale,
+        int                   block_size,
+        int                   max_n_kv,
+        int                   n_head_kv) {
+    return ggml_paged_attn_ext_v_dep(
+        ctx, q, k_cache, v_cache, block_table, kv_lens, NULL,
+        scale, block_size, max_n_kv, n_head_kv);
+}
+
+struct ggml_tensor * ggml_paged_attn_ext_v_dep(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * q,
+        struct ggml_tensor  * k_cache,
+        struct ggml_tensor  * v_cache,
+        struct ggml_tensor  * block_table,
+        struct ggml_tensor  * kv_lens,
+        struct ggml_tensor  * kv_write_dependency,
+        float                 scale,
+        int                   block_size,
+        int                   max_n_kv,
+        int                   n_head_kv) {
+    GGML_ASSERT(q->type == GGML_TYPE_F32);
+    GGML_ASSERT(k_cache->type == GGML_TYPE_F16);
+    GGML_ASSERT(v_cache->type == GGML_TYPE_F16);
+    GGML_ASSERT(block_table->type == GGML_TYPE_I32);
+    GGML_ASSERT(kv_lens == NULL || kv_lens->type == GGML_TYPE_I32);
+    GGML_ASSERT(kv_write_dependency == NULL ||
+                kv_write_dependency->op == GGML_OP_PAGED_KV_WRITE_EXT);
+    GGML_ASSERT(q->ne[1] == 1);
+    GGML_ASSERT(k_cache->ne[0] == v_cache->ne[0]);
+    GGML_ASSERT(k_cache->ne[1] == v_cache->ne[1]);
+    GGML_ASSERT(k_cache->ne[0] % n_head_kv == 0);
+    GGML_ASSERT(q->ne[0] == k_cache->ne[0] / n_head_kv);
+    GGML_ASSERT(q->ne[2] % n_head_kv == 0);
+    GGML_ASSERT((q->ne[3] == 1 && block_table->ne[1] == 1) ||
+                block_table->ne[1] == q->ne[3]);
+    GGML_ASSERT(ggml_is_contiguous(q));
+    GGML_ASSERT(ggml_is_contiguous(k_cache));
+    GGML_ASSERT(ggml_is_contiguous(v_cache));
+    GGML_ASSERT(ggml_is_contiguous(block_table));
+    GGML_ASSERT(kv_lens == NULL || ggml_is_contiguous(kv_lens));
+    GGML_ASSERT(kv_lens == NULL || kv_lens->ne[0] == q->ne[3]);
+    GGML_ASSERT(block_size > 0);
+    GGML_ASSERT(max_n_kv > 0);
+
+    int64_t ne[4] = { q->ne[0], q->ne[2], 1, q->ne[3] };
+    struct ggml_tensor * result = ggml_new_tensor(ctx, GGML_TYPE_F32, 4, ne);
+
+    ggml_set_op_params_f32(result, 0, scale);
+    ggml_set_op_params_i32(result, 1, block_size);
+    ggml_set_op_params_i32(result, 2, max_n_kv);
+    ggml_set_op_params_i32(result, 3, n_head_kv);
+
+    result->op     = GGML_OP_PAGED_ATTN_EXT;
+    result->src[0] = q;
+    result->src[1] = k_cache;
+    result->src[2] = v_cache;
+    result->src[3] = block_table;
+    result->src[4] = kv_lens;
+    result->src[5] = kv_write_dependency;
+
+    return result;
+}
+
+struct ggml_tensor * ggml_paged_kv_write_ext(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * k_cur,
+        struct ggml_tensor  * v_cur,
+        struct ggml_tensor  * k_cache,
+        struct ggml_tensor  * v_cache,
+        struct ggml_tensor  * block_table,
+        struct ggml_tensor  * positions,
+        int                   block_size) {
+    GGML_ASSERT(k_cur->type == GGML_TYPE_F32);
+    GGML_ASSERT(v_cur->type == GGML_TYPE_F32);
+    GGML_ASSERT(k_cache->type == GGML_TYPE_F16);
+    GGML_ASSERT(v_cache->type == GGML_TYPE_F16);
+    GGML_ASSERT(block_table->type == GGML_TYPE_I32);
+    GGML_ASSERT(positions->type == GGML_TYPE_I32);
+    GGML_ASSERT(k_cur->ne[0] == v_cur->ne[0]);
+    GGML_ASSERT(k_cur->ne[1] == v_cur->ne[1]);
+    GGML_ASSERT(k_cache->ne[0] == v_cache->ne[0]);
+    GGML_ASSERT(k_cache->ne[1] == v_cache->ne[1]);
+    GGML_ASSERT(k_cur->ne[0] == k_cache->ne[0]);
+    GGML_ASSERT(block_table->ne[1] == k_cur->ne[1]);
+    GGML_ASSERT(positions->ne[0] == k_cur->ne[1]);
+    GGML_ASSERT(block_size > 0);
+
+    struct ggml_tensor * result = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, 1);
+    ggml_set_op_params_i32(result, 0, block_size);
+
+    result->op     = GGML_OP_PAGED_KV_WRITE_EXT;
+    result->src[0] = k_cur;
+    result->src[1] = v_cur;
+    result->src[2] = k_cache;
+    result->src[3] = v_cache;
+    result->src[4] = block_table;
+    result->src[5] = positions;
+
+    return result;
+}
+
+struct ggml_tensor * ggml_fsmn_ext(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * v,
+        struct ggml_tensor  * weight,
+        int                   pad) {
+    GGML_ASSERT(v->type == GGML_TYPE_F32);
+    GGML_ASSERT(weight->type == GGML_TYPE_F16 || weight->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_3d(v));
+    GGML_ASSERT(weight->ne[1] == 1);
+    GGML_ASSERT(weight->ne[2] == v->ne[0]);
+    GGML_ASSERT(pad >= 0 && pad < weight->ne[0]);
+
+    struct ggml_tensor * result = ggml_dup_tensor(ctx, v);
+    ggml_set_op_params_i32(result, 0, pad);
+    result->op     = GGML_OP_FSMN_EXT;
+    result->src[0] = v;
+    result->src[1] = weight;
+    return result;
+}
