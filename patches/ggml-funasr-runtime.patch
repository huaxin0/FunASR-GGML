diff --git a/src/ggml-cuda/paged-attn.cu b/src/ggml-cuda/paged-attn.cu
new file mode 100644
index 00000000..3d7e1c22
--- /dev/null
+++ b/src/ggml-cuda/paged-attn.cu
@@ -0,0 +1,624 @@
+#include "paged-attn.cuh"
+#include "paged-kv-write.cuh"
+
+#include <cuda_fp16.h>
+#include <cfloat>
+#include <cstdlib>
+#include <cstring>
+
+namespace {
+
+struct paged_attn_profile_state {
+    long calls = 0;
+    double ms = 0.0;
+};
+
+paged_attn_profile_state g_paged_attn_profile;
+
+static bool paged_attn_profile_enabled() {
+    const char * value = std::getenv("FUNASR_PROFILE_PAGED_ATTN");
+    return value && std::strcmp(value, "0") != 0;
+}
+
+static bool paged_attn_v2_enabled() {
+    const char * value = std::getenv("FUNASR_PAGED_ATTN_V2");
+    return value && std::strcmp(value, "0") != 0;
+}
+
+static bool paged_attn_v1_enabled() {
+    const char * value = std::getenv("FUNASR_PAGED_ATTN_V1");
+    return value && std::strcmp(value, "0") != 0;
+}
+
+} // namespace
+
+GGML_CUDA_PAGED_ATTN_PROFILE_API void ggml_cuda_paged_attn_profile_reset() {
+    g_paged_attn_profile = paged_attn_profile_state{};
+}
+
+GGML_CUDA_PAGED_ATTN_PROFILE_API void ggml_cuda_paged_attn_profile_get(long * calls, double * ms) {
+    if (calls) {
+        *calls = g_paged_attn_profile.calls;
+    }
+    if (ms) {
+        *ms = g_paged_attn_profile.ms;
+    }
+}
+
+static __global__ void paged_kv_write_f32_to_f16_kernel(
+        const float * __restrict__ k_cur,
+        const float * __restrict__ v_cur,
+        half        * __restrict__ k_cache,
+        half        * __restrict__ v_cache,
+        const int   * __restrict__ block_table,
+        const int   * __restrict__ positions,
+        int kv_dim,
+        int batch,
+        int physical_rows,
+        int table_stride,
+        int block_size) {
+    const int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    const int n = kv_dim * batch;
+    if (idx >= n) {
+        return;
+    }
+
+    const int d = idx % kv_dim;
+    const int b = idx / kv_dim;
+    const int pos = positions[b];
+    const int block_idx = pos / block_size;
+    const int block_off = pos % block_size;
+    const int block_id = block_table[(size_t) b * table_stride + block_idx];
+    const int physical_row = block_id * block_size + block_off;
+    if (physical_row < 0 || physical_row >= physical_rows) {
+        return;
+    }
+
+    const size_t src = (size_t) b * kv_dim + d;
+    const size_t out = (size_t) physical_row * kv_dim + d;
+    k_cache[out] = __float2half(k_cur[src]);
+    v_cache[out] = __float2half(v_cur[src]);
+}
+
+void ggml_cuda_paged_kv_write_ext(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * k_cur       = dst->src[0];
+    const ggml_tensor * v_cur       = dst->src[1];
+    const ggml_tensor * k_cache     = dst->src[2];
+    const ggml_tensor * v_cache     = dst->src[3];
+    const ggml_tensor * block_table = dst->src[4];
+    const ggml_tensor * positions   = dst->src[5];
+
+    const int block_size = dst->op_params[0];
+    const int kv_dim = (int) k_cur->ne[0];
+    const int batch = (int) k_cur->ne[1];
+    const int physical_rows = (int) k_cache->ne[1];
+    const int table_stride = (int) block_table->ne[0];
+    const int n = kv_dim * batch;
+
+    const int threads = 256;
+    const int blocks = (n + threads - 1) / threads;
+    paged_kv_write_f32_to_f16_kernel<<<blocks, threads, 0, ctx.stream()>>>(
+        (const float *) k_cur->data,
+        (const float *) v_cur->data,
+        (half        *) k_cache->data,
+        (half        *) v_cache->data,
+        (const int   *) block_table->data,
+        (const int   *) positions->data,
+        kv_dim,
+        batch,
+        physical_rows,
+        table_stride,
+        block_size);
+}
+
+bool ggml_cuda_paged_kv_write_ext_supported(const ggml_tensor * dst) {
+    const ggml_tensor * k_cur       = dst->src[0];
+    const ggml_tensor * v_cur       = dst->src[1];
+    const ggml_tensor * k_cache     = dst->src[2];
+    const ggml_tensor * v_cache     = dst->src[3];
+    const ggml_tensor * block_table = dst->src[4];
+    const ggml_tensor * positions   = dst->src[5];
+
+    if (!k_cur || !v_cur || !k_cache || !v_cache || !block_table || !positions) {
+        return false;
+    }
+    if (k_cur->type != GGML_TYPE_F32 || v_cur->type != GGML_TYPE_F32 ||
+        k_cache->type != GGML_TYPE_F16 || v_cache->type != GGML_TYPE_F16 ||
+        block_table->type != GGML_TYPE_I32 || positions->type != GGML_TYPE_I32 ||
+        dst->type != GGML_TYPE_F32) {
+        return false;
+    }
+    if (k_cur->ne[0] != v_cur->ne[0] || k_cur->ne[1] != v_cur->ne[1] ||
+        k_cache->ne[0] != v_cache->ne[0] || k_cache->ne[1] != v_cache->ne[1] ||
+        k_cur->ne[0] != k_cache->ne[0] || block_table->ne[1] != k_cur->ne[1] ||
+        positions->ne[0] != k_cur->ne[1]) {
+        return false;
+    }
+    return ggml_is_contiguous(k_cur) && ggml_is_contiguous(v_cur) &&
+           ggml_is_contiguous(k_cache) && ggml_is_contiguous(v_cache) &&
+           ggml_is_contiguous(block_table) && ggml_is_contiguous(positions);
+}
+
+static __device__ __forceinline__ float warp_reduce_sum(float v) {
+#pragma unroll
+    for (int offset = 16; offset > 0; offset >>= 1) {
+        v += __shfl_down_sync(0xffffffff, v, offset);
+    }
+    return v;
+}
+
+static __device__ __forceinline__ float block_reduce_sum(float v) {
+    __shared__ float shared[32];
+    const int lane = threadIdx.x & 31;
+    const int wid  = threadIdx.x >> 5;
+
+    v = warp_reduce_sum(v);
+    if (lane == 0) {
+        shared[wid] = v;
+    }
+    __syncthreads();
+
+    v = threadIdx.x < (blockDim.x >> 5) ? shared[lane] : 0.0f;
+    if (wid == 0) {
+        v = warp_reduce_sum(v);
+    }
+    return v;
+}
+
+static __device__ __forceinline__ float warp_reduce_max(float v) {
+#pragma unroll
+    for (int offset = 16; offset > 0; offset >>= 1) {
+        v = fmaxf(v, __shfl_down_sync(0xffffffff, v, offset));
+    }
+    return v;
+}
+
+static __device__ __forceinline__ float block_reduce_max(float v) {
+    __shared__ float shared[32];
+    const int lane = threadIdx.x & 31;
+    const int wid  = threadIdx.x >> 5;
+
+    v = warp_reduce_max(v);
+    if (lane == 0) {
+        shared[wid] = v;
+    }
+    __syncthreads();
+
+    v = threadIdx.x < (blockDim.x >> 5) ? shared[lane] : -FLT_MAX;
+    if (wid == 0) {
+        v = warp_reduce_max(v);
+    }
+    return v;
+}
+
+__global__ void paged_attn_decode_f32_f16(
+        const float * __restrict__ q,
+        const half  * __restrict__ k_cache,
+        const half  * __restrict__ v_cache,
+        const int   * __restrict__ block_table,
+        const int   * __restrict__ kv_lens,
+        float       * __restrict__ dst,
+        int head_dim,
+        int n_heads,
+        int n_kv_heads,
+        int max_n_kv,
+        int block_size,
+        int kv_dim,
+        int table_stride,
+        float scale) {
+    extern __shared__ float scores[];
+    const int head = blockIdx.x;
+    const int batch = blockIdx.y;
+    if (head >= n_heads) {
+        return;
+    }
+
+    const int gqa_ratio = n_heads / n_kv_heads;
+    const int kv_head = head / gqa_ratio;
+    const int * block_table_b = block_table + (size_t) batch * table_stride;
+    const float * q_head = q + ((size_t) batch * n_heads + head) * head_dim;
+    const int n_kv = kv_lens ? kv_lens[batch] : max_n_kv;
+
+    float local_max = -FLT_MAX;
+    for (int pos = threadIdx.x; pos < n_kv; pos += blockDim.x) {
+        const int block_id = block_table_b[pos / block_size];
+        const int physical_row = block_id * block_size + (pos % block_size);
+        const half * k_row = k_cache + (size_t) physical_row * kv_dim + (size_t) kv_head * head_dim;
+
+        float dot = 0.0f;
+        for (int d = 0; d < head_dim; ++d) {
+            dot += q_head[d] * __half2float(k_row[d]);
+        }
+        const float score = dot * scale;
+        scores[pos] = score;
+        local_max = fmaxf(local_max, score);
+    }
+
+    __shared__ float s_max;
+    local_max = block_reduce_max(local_max);
+    if (threadIdx.x == 0) {
+        s_max = local_max;
+    }
+    __syncthreads();
+
+    float local_sum = 0.0f;
+    for (int pos = threadIdx.x; pos < n_kv; pos += blockDim.x) {
+        local_sum += expf(scores[pos] - s_max);
+    }
+    local_sum = block_reduce_sum(local_sum);
+
+    __shared__ float s_sum;
+    if (threadIdx.x == 0) {
+        s_sum = local_sum;
+    }
+    __syncthreads();
+
+    for (int pos = threadIdx.x; pos < n_kv; pos += blockDim.x) {
+        scores[pos] = expf(scores[pos] - s_max) / s_sum;
+    }
+    __syncthreads();
+
+    for (int d = threadIdx.x; d < head_dim; d += blockDim.x) {
+        float acc = 0.0f;
+        for (int pos = 0; pos < n_kv; ++pos) {
+            const int block_id = block_table_b[pos / block_size];
+            const int physical_row = block_id * block_size + (pos % block_size);
+            const half * v_row = v_cache + (size_t) physical_row * kv_dim + (size_t) kv_head * head_dim;
+            acc += scores[pos] * __half2float(v_row[d]);
+        }
+        dst[((size_t) batch * n_heads + head) * head_dim + d] = acc;
+    }
+}
+
+__global__ void paged_attn_decode_f32_f16_warp_qk(
+        const float * __restrict__ q,
+        const half  * __restrict__ k_cache,
+        const half  * __restrict__ v_cache,
+        const int   * __restrict__ block_table,
+        const int   * __restrict__ kv_lens,
+        float       * __restrict__ dst,
+        int head_dim,
+        int n_heads,
+        int n_kv_heads,
+        int max_n_kv,
+        int block_size,
+        int kv_dim,
+        int table_stride,
+        float scale) {
+    extern __shared__ float scores[];
+    const int head = blockIdx.x;
+    const int batch = blockIdx.y;
+    if (head >= n_heads) {
+        return;
+    }
+
+    const int lane = threadIdx.x & 31;
+    const int warp = threadIdx.x >> 5;
+    const int n_warps = blockDim.x >> 5;
+
+    const int gqa_ratio = n_heads / n_kv_heads;
+    const int kv_head = head / gqa_ratio;
+    const int * block_table_b = block_table + (size_t) batch * table_stride;
+    const float * q_head = q + ((size_t) batch * n_heads + head) * head_dim;
+    const int n_kv = kv_lens ? kv_lens[batch] : max_n_kv;
+
+    float local_max = -FLT_MAX;
+    for (int pos = warp; pos < n_kv; pos += n_warps) {
+        const int block_id = block_table_b[pos / block_size];
+        const int physical_row = block_id * block_size + (pos % block_size);
+        const half * k_row = k_cache + (size_t) physical_row * kv_dim + (size_t) kv_head * head_dim;
+
+        float dot = 0.0f;
+        for (int d = lane; d < head_dim; d += 32) {
+            dot += q_head[d] * __half2float(k_row[d]);
+        }
+        dot = warp_reduce_sum(dot);
+        if (lane == 0) {
+            const float score = dot * scale;
+            scores[pos] = score;
+            local_max = fmaxf(local_max, score);
+        }
+    }
+
+    __shared__ float s_max;
+    local_max = block_reduce_max(local_max);
+    if (threadIdx.x == 0) {
+        s_max = local_max;
+    }
+    __syncthreads();
+
+    float local_sum = 0.0f;
+    for (int pos = threadIdx.x; pos < n_kv; pos += blockDim.x) {
+        local_sum += expf(scores[pos] - s_max);
+    }
+    local_sum = block_reduce_sum(local_sum);
+
+    __shared__ float s_sum;
+    if (threadIdx.x == 0) {
+        s_sum = local_sum;
+    }
+    __syncthreads();
+
+    for (int pos = threadIdx.x; pos < n_kv; pos += blockDim.x) {
+        scores[pos] = expf(scores[pos] - s_max) / s_sum;
+    }
+    __syncthreads();
+
+    for (int d = threadIdx.x; d < head_dim; d += blockDim.x) {
+        float acc = 0.0f;
+        for (int pos = 0; pos < n_kv; ++pos) {
+            const int block_id = block_table_b[pos / block_size];
+            const int physical_row = block_id * block_size + (pos % block_size);
+            const half * v_row = v_cache + (size_t) physical_row * kv_dim + (size_t) kv_head * head_dim;
+            acc += scores[pos] * __half2float(v_row[d]);
+        }
+        dst[((size_t) batch * n_heads + head) * head_dim + d] = acc;
+    }
+}
+
+__global__ void paged_attn_decode_f32_f16_warp_qk_cached_rows(
+        const float * __restrict__ q,
+        const half  * __restrict__ k_cache,
+        const half  * __restrict__ v_cache,
+        const int   * __restrict__ block_table,
+        const int   * __restrict__ kv_lens,
+        float       * __restrict__ dst,
+        int head_dim,
+        int n_heads,
+        int n_kv_heads,
+        int max_n_kv,
+        int block_size,
+        int kv_dim,
+        int table_stride,
+        float scale) {
+    extern __shared__ char shared_raw[];
+    float * scores = reinterpret_cast<float *>(shared_raw);
+    int * physical_rows = reinterpret_cast<int *>(scores + max_n_kv);
+
+    const int head = blockIdx.x;
+    const int batch = blockIdx.y;
+    if (head >= n_heads) {
+        return;
+    }
+
+    const int lane = threadIdx.x & 31;
+    const int warp = threadIdx.x >> 5;
+    const int n_warps = blockDim.x >> 5;
+
+    const int gqa_ratio = n_heads / n_kv_heads;
+    const int kv_head = head / gqa_ratio;
+    const int * block_table_b = block_table + (size_t) batch * table_stride;
+    const float * q_head = q + ((size_t) batch * n_heads + head) * head_dim;
+    const int n_kv = kv_lens ? kv_lens[batch] : max_n_kv;
+
+    float local_max = -FLT_MAX;
+    for (int pos = warp; pos < n_kv; pos += n_warps) {
+        const int block_id = block_table_b[pos / block_size];
+        const int physical_row = block_id * block_size + (pos % block_size);
+        const half * k_row = k_cache + (size_t) physical_row * kv_dim + (size_t) kv_head * head_dim;
+
+        float dot = 0.0f;
+        for (int d = lane; d < head_dim; d += 32) {
+            dot += q_head[d] * __half2float(k_row[d]);
+        }
+        dot = warp_reduce_sum(dot);
+        if (lane == 0) {
+            const float score = dot * scale;
+            scores[pos] = score;
+            physical_rows[pos] = physical_row;
+            local_max = fmaxf(local_max, score);
+        }
+    }
+
+    __shared__ float s_max;
+    local_max = block_reduce_max(local_max);
+    if (threadIdx.x == 0) {
+        s_max = local_max;
+    }
+    __syncthreads();
+
+    float local_sum = 0.0f;
+    for (int pos = threadIdx.x; pos < n_kv; pos += blockDim.x) {
+        local_sum += expf(scores[pos] - s_max);
+    }
+    local_sum = block_reduce_sum(local_sum);
+
+    __shared__ float s_sum;
+    if (threadIdx.x == 0) {
+        s_sum = local_sum;
+    }
+    __syncthreads();
+
+    for (int pos = threadIdx.x; pos < n_kv; pos += blockDim.x) {
+        scores[pos] = expf(scores[pos] - s_max) / s_sum;
+    }
+    __syncthreads();
+
+    for (int d = threadIdx.x; d < head_dim; d += blockDim.x) {
+        float acc = 0.0f;
+        for (int pos = 0; pos < n_kv; ++pos) {
+            const half * v_row = v_cache + (size_t) physical_rows[pos] * kv_dim + (size_t) kv_head * head_dim;
+            acc += scores[pos] * __half2float(v_row[d]);
+        }
+        dst[((size_t) batch * n_heads + head) * head_dim + d] = acc;
+    }
+}
