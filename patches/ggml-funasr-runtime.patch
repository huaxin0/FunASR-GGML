+struct ggml_tensor * ggml_paged_attn_ext(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * q,
+        struct ggml_tensor  * k_cache,
+        struct ggml_tensor  * v_cache,
+        struct ggml_tensor  * block_table,
+        float                 scale,
+        int                   block_size,
+        int                   n_kv,
+        int                   n_head_kv) {
