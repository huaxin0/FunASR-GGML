diff --git a/src/ggml-cuda/fsmn.cu b/src/ggml-cuda/fsmn.cu
new file mode 100644
index 00000000..ef1f9625
--- /dev/null
+++ b/src/ggml-cuda/fsmn.cu
@@ -0,0 +1,90 @@
+#include "fsmn.cuh"
+
+#include <cuda_fp16.h>
+#include <type_traits>
+
+template <typename W>
+static __global__ void fsmn_ext_kernel(
+        const float * __restrict__ v,
+        const W     * __restrict__ w,
+        float       * __restrict__ dst,
+        int dim,
+        int T,
+        int batch,
+        int K,
+        int pad) {
+    const int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    const int n = dim * T * batch;
+    if (idx >= n) {
+        return;
+    }
+
+    const int d = idx % dim;
+    const int row = idx / dim;
+    const int t = row % T;
+    const int b = row / T;
+    const size_t sequence_offset = (size_t) b * T * dim;
+
+    float acc = v[idx];
+    const W * w_row = w + (size_t) d * K;
+    for (int k = 0; k < K; k++) {
+        const int src_t = t + k - pad;
+        if (src_t < 0 || src_t >= T) {
+            continue;
+        }
+        float wk;
+        if constexpr (std::is_same<W, half>::value) {
+            wk = __half2float(w_row[k]);
+        } else {
+            wk = static_cast<float>(w_row[k]);
+        }
+        acc += v[sequence_offset + (size_t) src_t * dim + d] * wk;
+    }
+    dst[idx] = acc;
+}
+
+void ggml_cuda_fsmn_ext(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * v = dst->src[0];
+    const ggml_tensor * w = dst->src[1];
+
+    const int pad = dst->op_params[0];
+    const int dim = (int) v->ne[0];
+    const int T   = (int) v->ne[1];
+    const int batch = (int) v->ne[2];
+    const int K   = (int) w->ne[0];
+    const int n   = dim * T * batch;
+
+    const int threads = 256;
+    const int blocks = (n + threads - 1) / threads;
+    if (w->type == GGML_TYPE_F16) {
+        fsmn_ext_kernel<<<blocks, threads, 0, ctx.stream()>>>(
+            (const float *) v->data,
+            (const half  *) w->data,
+            (float       *) dst->data,
+            dim, T, batch, K, pad);
+    } else {
+        fsmn_ext_kernel<<<blocks, threads, 0, ctx.stream()>>>(
+            (const float *) v->data,
+            (const float *) w->data,
+            (float       *) dst->data,
+            dim, T, batch, K, pad);
+    }
+}
+
+bool ggml_cuda_fsmn_ext_supported(const ggml_tensor * dst) {
+    const ggml_tensor * v = dst->src[0];
+    const ggml_tensor * w = dst->src[1];
+    if (!v || !w) {
+        return false;
+    }
+    if (v->type != GGML_TYPE_F32 ||
+        (w->type != GGML_TYPE_F16 && w->type != GGML_TYPE_F32) ||
+        dst->type != GGML_TYPE_F32) {
+        return false;
+    }
+    if (v->ne[2] <= 0 || v->ne[3] != 1 ||
+        w->ne[1] != 1 || w->ne[2] != v->ne[0]) {
+        return false;
+    }
+    return ggml_is_contiguous(v) && ggml_is_contiguous(w);
+}
