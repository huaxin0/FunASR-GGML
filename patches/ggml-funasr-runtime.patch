+void ggml_cuda_paged_attn_ext(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * q           = dst->src[0];
+    const ggml_tensor * k_cache     = dst->src[1];
+    const ggml_tensor * v_cache     = dst->src[2];
+    const ggml_tensor * block_table = dst->src[3];
+    const ggml_tensor * kv_lens     = dst->src[4];
+
+    float scale;
+    memcpy(&scale, (const float *) dst->op_params + 0, sizeof(float));
+    const int block_size = dst->op_params[1];
+    const int max_n_kv   = dst->op_params[2];
+    const int n_kv_heads = dst->op_params[3];
+
+    const int head_dim = q->ne[0];
+    const int n_heads  = q->ne[2];
+    const int n_batch  = q->ne[3];
+    const int kv_dim   = k_cache->ne[0];
+    const int table_stride = block_table->ne[0];
+
+    const dim3 grid(n_heads, n_batch, 1);
+    const dim3 block(256, 1, 1);
+
+    const bool use_v1 = paged_attn_v1_enabled();
+    const bool use_v2 = !use_v1 && paged_attn_v2_enabled();
+    const bool use_v3 = !use_v1 && !use_v2;
+    const size_t shared = (size_t) max_n_kv * sizeof(float) +
+                          (use_v3 ? (size_t) max_n_kv * sizeof(int) : 0);
+    if (paged_attn_profile_enabled()) {
+        cudaEvent_t start;
+        cudaEvent_t stop;
+        CUDA_CHECK(cudaEventCreate(&start));
+        CUDA_CHECK(cudaEventCreate(&stop));
+        CUDA_CHECK(cudaEventRecord(start, ctx.stream()));
+        if (use_v3) {
+            paged_attn_decode_f32_f16_warp_qk_cached_rows<<<grid, block, shared, ctx.stream()>>>(
+                (const float *) q->data,
+                (const half  *) k_cache->data,
+                (const half  *) v_cache->data,
+                (const int   *) block_table->data,
+                kv_lens ? (const int *) kv_lens->data : nullptr,
+                (float       *) dst->data,
+                head_dim,
+                n_heads,
+                n_kv_heads,
+                max_n_kv,
+                block_size,
+                kv_dim,
+                table_stride,
+                scale);
+        } else if (use_v2) {
+            paged_attn_decode_f32_f16_warp_qk<<<grid, block, shared, ctx.stream()>>>(
+                (const float *) q->data,
+                (const half  *) k_cache->data,
+                (const half  *) v_cache->data,
+                (const int   *) block_table->data,
+                kv_lens ? (const int *) kv_lens->data : nullptr,
+                (float       *) dst->data,
+                head_dim,
+                n_heads,
+                n_kv_heads,
+                max_n_kv,
+                block_size,
+                kv_dim,
+                table_stride,
+                scale);
+        } else {
+            paged_attn_decode_f32_f16<<<grid, block, shared, ctx.stream()>>>(
+                (const float *) q->data,
+                (const half  *) k_cache->data,
+                (const half  *) v_cache->data,
+                (const int   *) block_table->data,
+                kv_lens ? (const int *) kv_lens->data : nullptr,
+                (float       *) dst->data,
+                head_dim,
+                n_heads,
+                n_kv_heads,
+                max_n_kv,
+                block_size,
+                kv_dim,
+                table_stride,
+                scale);
+        }
+        CUDA_CHECK(cudaEventRecord(stop, ctx.stream()));
+        CUDA_CHECK(cudaEventSynchronize(stop));
+        float elapsed = 0.0f;
+        CUDA_CHECK(cudaEventElapsedTime(&elapsed, start, stop));
+        CUDA_CHECK(cudaEventDestroy(start));
+        CUDA_CHECK(cudaEventDestroy(stop));
+        g_paged_attn_profile.calls++;
+        g_paged_attn_profile.ms += static_cast<double>(elapsed);
+    } else {
+        if (use_v3) {
+            paged_attn_decode_f32_f16_warp_qk_cached_rows<<<grid, block, shared, ctx.stream()>>>(
+                (const float *) q->data,
+                (const half  *) k_cache->data,
+                (const half  *) v_cache->data,
+                (const int   *) block_table->data,
+                kv_lens ? (const int *) kv_lens->data : nullptr,
+                (float       *) dst->data,
+                head_dim,
+                n_heads,
+                n_kv_heads,
+                max_n_kv,
+                block_size,
+                kv_dim,
+                table_stride,
+                scale);
+        } else if (use_v2) {
+            paged_attn_decode_f32_f16_warp_qk<<<grid, block, shared, ctx.stream()>>>(
+                (const float *) q->data,
+                (const half  *) k_cache->data,
+                (const half  *) v_cache->data,
+                (const int   *) block_table->data,
+                kv_lens ? (const int *) kv_lens->data : nullptr,
+                (float       *) dst->data,
+                head_dim,
+                n_heads,
+                n_kv_heads,
+                max_n_kv,
+                block_size,
+                kv_dim,
+                table_stride,
+                scale);
+        } else {
+            paged_attn_decode_f32_f16<<<grid, block, shared, ctx.stream()>>>(
+                (const float *) q->data,
+                (const half  *) k_cache->data,
+                (const half  *) v_cache->data,
+                (const int   *) block_table->data,
+                kv_lens ? (const int *) kv_lens->data : nullptr,
+                (float       *) dst->data,
+                head_dim,
+                n_heads,
+                n_kv_heads,
+                max_n_kv,
+                block_size,
+                kv_dim,
+                table_stride,
+                scale);
+        }
+    }
+}
+
+bool ggml_cuda_paged_attn_ext_supported(const ggml_tensor * dst) {
+    const ggml_tensor * q           = dst->src[0];
+    const ggml_tensor * k_cache     = dst->src[1];
+    const ggml_tensor * v_cache     = dst->src[2];
+    const ggml_tensor * block_table = dst->src[3];
+    const ggml_tensor * kv_lens     = dst->src[4];
+    const ggml_tensor * kv_write_dependency = dst->src[5];
+
+    if (!q || !k_cache || !v_cache || !block_table) {
+        return false;
+    }
+    if (q->type != GGML_TYPE_F32 || k_cache->type != GGML_TYPE_F16 ||
+        v_cache->type != GGML_TYPE_F16 || block_table->type != GGML_TYPE_I32) {
+        return false;
+    }
+    if (kv_lens && (kv_lens->type != GGML_TYPE_I32 || kv_lens->ne[0] != q->ne[3])) {
+        return false;
+    }
+    if (kv_write_dependency && kv_write_dependency->op != GGML_OP_PAGED_KV_WRITE_EXT) {
+        return false;
+    }
+    if (q->ne[1] != 1) {
+        return false;
+    }
+    if (!((q->ne[3] == 1 && block_table->ne[1] == 1) ||
+          block_table->ne[1] == q->ne[3])) {
+        return false;
+    }
+    if (!ggml_is_contiguous(q) || !ggml_is_contiguous(k_cache) ||
+        !ggml_is_contiguous(v_cache) || !ggml_is_contiguous(block_table) ||
+        (kv_lens && !ggml_is_contiguous(kv_lens))) {
+        return false;
+    }
+    return k_cache->ne[0] == v_cache->ne[0] && k_cache->ne[1] == v_cache->ne[1];
+}
